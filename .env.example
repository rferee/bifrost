# Copy to .env (which is gitignored) and fill in.
#
# Pinned so itzg does not generate a new random RCON password on every boot and
# so bifrost and the server agree on it.
RCON_PASSWORD=change-me

# The Nextcloud app password goes in secrets/nextcloud_app_password, not here:
#   mkdir -p secrets && printf '%s' '<app password>' > secrets/nextcloud_app_password
